// Tree foliage in the style of the grass: alpha-cut leaf cards that always face the camera, lit with a
// rounded canopy normal and flattened into toon bands, coloured by the same world-space patch noise,
// and swayed by the shared wind. Use it on a mesh generated by PixelFoliageCanopy.
Shader "PixelPipeline/Foliage"
{
    Properties
    {
        [Header(Leaves)]
        [NoScaleOffset] _LeafTexture ("Leaf Sprite", 2D) = "white" {}
        _Cutoff ("Alpha Cutoff", Range(0, 1)) = 0.5
        _CardSizeScale ("Card Size Scale", Range(0.1, 3)) = 1
        _CardRotationJitter ("Card Rotation Jitter (degrees)", Range(0, 180)) = 180
        _TextureDetail ("Sprite Shading Detail", Range(0, 1)) = 0.35

        [Header(Colour)]
        _BaseColor ("Base Color", Color) = (0.36, 0.55, 0.25, 1)
        _Color2 ("Patch Color 2", Color) = (0.45, 0.63, 0.27, 1)
        [NoScaleOffset] _Noise2 ("Patch Noise 2", 2D) = "white" {}
        _Noise2Scale ("Noise 2 World Scale", Range(0, 1)) = 0.12
        _Noise2Threshold ("Noise 2 Threshold", Range(0, 1)) = 0.55
        _Color3 ("Patch Color 3", Color) = (0.26, 0.42, 0.2, 1)
        [NoScaleOffset] _Noise3 ("Patch Noise 3", 2D) = "white" {}
        _Noise3Scale ("Noise 3 World Scale", Range(0, 1)) = 0.08
        _Noise3Threshold ("Noise 3 Threshold", Range(0, 1)) = 0.6
        _ColorVariation ("Per-Card Variation", Range(0, 0.3)) = 0.06

        [Header(Lighting)]
        _Cuts ("Light Bands", Range(1, 8)) = 3
        _Wrap ("Wrap", Range(-1, 1)) = 0.2
        _Steepness ("Steepness", Range(0.5, 4)) = 1.2
        _InnerDarkness ("Inner Darkness", Range(0, 1)) = 0.45
        _ShadowSampleOffset ("Shadow Sample Offset (m)", Range(0, 1)) = 0.2

        [Header(Wind)]
        [NoScaleOffset] _WindNoise ("Wind Noise", 2D) = "gray" {}
        _WindNoiseScale ("Wind Noise Scale", Range(0, 0.5)) = 0.07
        _WindNoiseSpeed ("Wind Noise Speed", Range(0, 0.5)) = 0.05
        _WindSway ("Wind Sway (m)", Range(0, 0.5)) = 0.08
        _FlutterStrength ("Flutter Strength", Range(0, 0.2)) = 0.025
        _FlutterSpeed ("Flutter Speed", Range(0, 10)) = 3.5

        [Header(Outline)]
        [Toggle] _OutlineExclude ("Exclude From Outline", Float) = 0
    }

    SubShader
    {
        Tags
        {
            "RenderType" = "TransparentCutout"
            "RenderPipeline" = "UniversalPipeline"
            "Queue" = "AlphaTest"
            // The cards are expanded from their centres in world space; batching would bake the object
            // transform into the vertices and break the per-object scale.
            "DisableBatching" = "True"
        }

        Pass
        {
            Name "ForwardLit"
            Tags { "LightMode" = "UniversalForwardOnly" }

            Cull Off

            HLSLPROGRAM
            #pragma target 3.5
            #pragma vertex FoliageForwardVertex
            #pragma fragment FoliageForwardFragment
            #pragma multi_compile_instancing
            #pragma multi_compile_fog
            #pragma multi_compile _ _MAIN_LIGHT_SHADOWS _MAIN_LIGHT_SHADOWS_CASCADE _MAIN_LIGHT_SHADOWS_SCREEN
            #pragma multi_compile _ _ADDITIONAL_LIGHTS
            #pragma multi_compile _ _CLUSTER_LIGHT_LOOP
            #pragma multi_compile_fragment _ _ADDITIONAL_LIGHT_SHADOWS

            #include "Packages/com.schyro.pixel-pipeline/Shaders/Foliage/PixelFoliageCommon.hlsl"
            #include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Lighting.hlsl"
            #include "Packages/com.schyro.pixel-pipeline/Shaders/Lighting/PixelShadows.hlsl"
            #include "Packages/com.schyro.pixel-pipeline/Shaders/Lighting/PixelAdditionalLights.hlsl"

            struct Varyings
            {
                float4 positionCS : SV_POSITION;
                float2 uv : TEXCOORD0;
                float3 centreWS : TEXCOORD1;
                float3 normalWS : TEXCOORD2;
                // x: per-card random, y: canopy occlusion, z: fog factor.
                float3 cardData : TEXCOORD3;
                UNITY_VERTEX_INPUT_INSTANCE_ID
                UNITY_VERTEX_OUTPUT_STEREO
            };

            Varyings FoliageForwardVertex(FoliageAttributes input)
            {
                Varyings output;
                UNITY_SETUP_INSTANCE_ID(input);
                UNITY_TRANSFER_INSTANCE_ID(input, output);
                UNITY_INITIALIZE_VERTEX_OUTPUT_STEREO(output);

                FoliageVertex foliage = PixelFoliageExpand(input);
                output.positionCS = TransformWorldToHClip(foliage.positionWS);
                output.uv = foliage.uv;
                output.centreWS = foliage.centreWS;
                output.normalWS = foliage.normalWS;
                output.cardData = float3(foliage.seed, foliage.occlusion, ComputeFogFactor(output.positionCS.z));
                return output;
            }

            half4 FoliageForwardFragment(Varyings input) : SV_Target
            {
                UNITY_SETUP_INSTANCE_ID(input);
                UNITY_SETUP_STEREO_EYE_INDEX_POST_VERTEX(input);

                half4 sprite = SAMPLE_TEXTURE2D(_LeafTexture, sampler_LeafTexture, input.uv);
                clip(sprite.a - _Cutoff);

                // Patch colours are chosen per card, from the card centre, so a card is never split
                // between two colours and the patches read as clusters of leaves.
                float2 patchPosition = input.centreWS.xz + input.centreWS.y * 0.37;
                half3 albedo = _BaseColor.rgb;
                if (SAMPLE_TEXTURE2D(_Noise2, sampler_Noise2, patchPosition * _Noise2Scale).r > _Noise2Threshold)
                    albedo = _Color2.rgb;
                if (SAMPLE_TEXTURE2D(_Noise3, sampler_Noise3, patchPosition * _Noise3Scale).r > _Noise3Threshold)
                    albedo = _Color3.rgb;

                half seed = input.cardData.x;
                albedo *= 1.0h + (seed - 0.5h) * 2.0h * _ColorVariation;
                half spriteShade = dot(sprite.rgb, half3(0.299h, 0.587h, 0.114h));
                albedo *= lerp(1.0h, spriteShade, _TextureDetail);

                half3 normalWS = normalize(input.normalWS);
                Light mainLight = GetMainLight();
                // The whole card shares one shadow sample taken just outside the canopy surface, so
                // shadows break the crown into leaf-sized clusters instead of speckling every card.
                half shadow = PixelPipelineMainLightShadow(input.centreWS + normalWS * _ShadowSampleOffset);

                half diffuse = saturate((dot(normalWS, mainLight.direction) + _Wrap) / (1.0h + _Wrap) * _Steepness);
                half cuts = max(1.0h, round(_Cuts));
                half banded = saturate(ceil(diffuse * cuts - 0.001h) / cuts);

                half occlusion = input.cardData.y;
                half innerShade = lerp(1.0h - _InnerDarkness, 1.0h, occlusion);
                half3 ambient = SampleSH(normalWS) * innerShade;
                half3 direct = mainLight.color * (banded * shadow * innerShade);
                // From the card centre, like the shadow, so a card is never split between two tones.
                direct += PixelPipelineAdditionalLights(
                    input.centreWS,
                    GetNormalizedScreenSpaceUV(input.positionCS),
                    normalWS,
                    _Wrap,
                    cuts) * innerShade;

                half3 color = albedo * (direct + ambient);
                color = MixFog(color, input.cardData.z);
                return half4(color, 1.0h);
            }
            ENDHLSL
        }

        Pass
        {
            Name "ShadowCaster"
            Tags { "LightMode" = "ShadowCaster" }

            Cull Off
            ZWrite On
            ZTest LEqual
            ColorMask 0

            HLSLPROGRAM
            #pragma target 3.5
            #pragma vertex FoliageShadowVertex
            #pragma fragment FoliageClipFragment
            #pragma multi_compile_instancing
            #pragma multi_compile_vertex _ _CASTING_PUNCTUAL_LIGHT_SHADOW

            #include "Packages/com.schyro.pixel-pipeline/Shaders/Foliage/PixelFoliageCommon.hlsl"
            #include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Shadows.hlsl"

            float3 _LightDirection;
            float3 _LightPosition;

            struct Varyings
            {
                float4 positionCS : SV_POSITION;
                float2 uv : TEXCOORD0;
                UNITY_VERTEX_INPUT_INSTANCE_ID
            };

            Varyings FoliageShadowVertex(FoliageAttributes input)
            {
                Varyings output;
                UNITY_SETUP_INSTANCE_ID(input);
                UNITY_TRANSFER_INSTANCE_ID(input, output);

                FoliageVertex foliage = PixelFoliageExpand(input);
                // The card faces the light here, so its facing direction is the useful bias normal.
                float3 facingWS = UNITY_MATRIX_V[2].xyz;

                #if _CASTING_PUNCTUAL_LIGHT_SHADOW
                    float3 lightDirectionWS = normalize(_LightPosition - foliage.positionWS);
                #else
                    float3 lightDirectionWS = _LightDirection;
                #endif

                float4 positionCS = TransformWorldToHClip(ApplyShadowBias(foliage.positionWS, facingWS, lightDirectionWS));
                output.positionCS = ApplyShadowClamping(positionCS);
                output.uv = foliage.uv;
                return output;
            }

            half4 FoliageClipFragment(Varyings input) : SV_Target
            {
                clip(PixelFoliageAlpha(input.uv) - _Cutoff);
                return 0;
            }
            ENDHLSL
        }

        Pass
        {
            Name "DepthOnly"
            Tags { "LightMode" = "DepthOnly" }

            Cull Off
            ZWrite On
            ColorMask R

            HLSLPROGRAM
            #pragma target 3.5
            #pragma vertex FoliageDepthVertex
            #pragma fragment FoliageDepthFragment
            #pragma multi_compile_instancing

            #include "Packages/com.schyro.pixel-pipeline/Shaders/Foliage/PixelFoliageCommon.hlsl"

            struct Varyings
            {
                float4 positionCS : SV_POSITION;
                float2 uv : TEXCOORD0;
                UNITY_VERTEX_INPUT_INSTANCE_ID
            };

            Varyings FoliageDepthVertex(FoliageAttributes input)
            {
                Varyings output;
                UNITY_SETUP_INSTANCE_ID(input);
                UNITY_TRANSFER_INSTANCE_ID(input, output);

                FoliageVertex foliage = PixelFoliageExpand(input);
                output.positionCS = TransformWorldToHClip(foliage.positionWS);
                output.uv = foliage.uv;
                return output;
            }

            half FoliageDepthFragment(Varyings input) : SV_Target
            {
                clip(PixelFoliageAlpha(input.uv) - _Cutoff);
                return input.positionCS.z;
            }
            ENDHLSL
        }

        Pass
        {
            Name "DepthNormals"
            Tags { "LightMode" = "DepthNormalsOnly" }

            Cull Off
            ZWrite On

            HLSLPROGRAM
            #pragma target 3.5
            #pragma vertex FoliageDepthNormalsVertex
            #pragma fragment FoliageDepthNormalsFragment
            #pragma multi_compile_instancing
            #pragma multi_compile_fragment _ _GBUFFER_NORMALS_OCT

            #include "Packages/com.schyro.pixel-pipeline/Shaders/Foliage/PixelFoliageCommon.hlsl"
            #include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Packing.hlsl"

            struct Varyings
            {
                float4 positionCS : SV_POSITION;
                float2 uv : TEXCOORD0;
                float3 normalWS : TEXCOORD1;
                UNITY_VERTEX_INPUT_INSTANCE_ID
            };

            Varyings FoliageDepthNormalsVertex(FoliageAttributes input)
            {
                Varyings output;
                UNITY_SETUP_INSTANCE_ID(input);
                UNITY_TRANSFER_INSTANCE_ID(input, output);

                FoliageVertex foliage = PixelFoliageExpand(input);
                output.positionCS = TransformWorldToHClip(foliage.positionWS);
                output.uv = foliage.uv;
                output.normalWS = foliage.normalWS;
                return output;
            }

            half4 FoliageDepthNormalsFragment(Varyings input) : SV_Target
            {
                clip(PixelFoliageAlpha(input.uv) - _Cutoff);

                // The same impossible-normal marker the grass writes: the outline pass skips these
                // pixels, while their depth still hides lines of geometry behind the crown.
                if (_OutlineExclude > 0.5)
                    return half4(1.0, 0.0, 1.0, 1.0);

                float3 normalWS = normalize(input.normalWS);
                #if defined(_GBUFFER_NORMALS_OCT)
                    float2 octNormalWS = PackNormalOctQuadEncode(normalWS);
                    float2 remappedOctNormalWS = saturate(octNormalWS * 0.5 + 0.5);
                    return half4(PackFloat2To888(remappedOctNormalWS), 0.0);
                #else
                    return half4(normalWS, 0.0);
                #endif
            }
            ENDHLSL
        }
    }

    Fallback Off
}

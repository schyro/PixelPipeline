.pp-root {
    flex-grow: 1;
}

.pp-toolbar {
    flex-direction: row;
    align-items: center;
    padding: 4px 6px;
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-default-border);
    background-color: var(--unity-colors-toolbar-background);
}

.pp-toolbar__title {
    -unity-font-style: bold;
    font-size: 13px;
    margin-right: 8px;
}

.pp-toolbar__asset {
    flex-grow: 1;
    margin-right: 4px;
}

.pp-body {
    flex-direction: row;
    flex-grow: 1;
}

.pp-sidebar {
    width: 150px;
    min-width: 150px;
    padding-top: 4px;
    border-right-width: 1px;
    border-right-color: var(--unity-colors-default-border);
    background-color: var(--unity-colors-window-background);
}

.pp-sidebar__group {
    -unity-font-style: bold;
    font-size: 10px;
    color: var(--unity-colors-default-text-hover);
    opacity: 0.6;
    margin: 8px 10px 2px 10px;
}

.pp-tab {
    margin: 0;
    padding: 4px 10px 4px 12px;
    border-width: 0;
    border-radius: 0;
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
    -unity-text-align: middle-left;
    height: 24px;
}

.pp-tab:hover {
    background-color: var(--unity-colors-button-background-hover);
}

.pp-tab--selected {
    border-left-color: rgb(58, 121, 187);
    background-color: var(--unity-colors-highlight-background-inactive);
    -unity-font-style: bold;
}

.pp-content {
    flex-grow: 1;
}

.pp-page {
    padding: 10px 14px 16px 12px;
}

/* One label column for every field on a page, as in the Inspector; long names are cut with an
   ellipsis and remain readable in the tooltip. */
.pp-page > .unity-property-field > .unity-base-field > .unity-base-field__label {
    width: 200px;
    min-width: 200px;
    max-width: 200px;
    overflow: hidden;
    text-overflow: ellipsis;
}

.pp-page__title {
    font-size: 16px;
    -unity-font-style: bold;
    margin-bottom: 2px;
}

.pp-page__description {
    white-space: normal;
    opacity: 0.75;
    margin-bottom: 8px;
}

.pp-card {
    margin: 4px 0 10px 0;
    padding: 8px;
    border-width: 1px;
    border-radius: 4px;
    border-color: var(--unity-colors-default-border);
    background-color: var(--unity-colors-helpbox-background);
}

.pp-card__title {
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.pp-card__caption {
    font-size: 10px;
    opacity: 0.7;
    white-space: normal;
    margin-top: 4px;
}

.pp-strip {
    height: 18px;
    margin-bottom: 3px;
    border-radius: 2px;
}

.pp-strip-label {
    width: 90px;
    -unity-text-align: middle-left;
    font-size: 10px;
}

.pp-row {
    flex-direction: row;
    align-items: center;
}

.pp-grow {
    flex-grow: 1;
}

.pp-axis {
    flex-direction: row;
    justify-content: space-between;
    margin-left: 90px;
    font-size: 9px;
    opacity: 0.6;
}

.pp-weather-column {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 4px;
}

.pp-bar-track {
    height: 8px;
    border-radius: 2px;
    background-color: rgba(0, 0, 0, 0.25);
    margin: 1px 0 4px 0;
}

.pp-bar-fill {
    height: 100%;
    border-radius: 2px;
}

.pp-bar-label {
    font-size: 10px;
}

.pp-empty {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}
